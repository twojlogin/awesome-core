{
    "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
    "name": "io.github.twojlogin/awesome-core",
    "title": "Awesome Core",
    "description": "Read-only MCP server over a local, offline catalog of tools from GitHub awesome lists.",
    "version": "2.2.0",
    "websiteUrl": "https://github.com/twojlogin/awesome-core",
    "repository": {
        "url": "https://github.com/twojlogin/awesome-core",
        "source": "github"
    },
    "packages": [
        {
            "registryType": "pypi",
            "registryBaseUrl": "https://pypi.org",
            "identifier": "awesome-core",
            "version": "2.2.0",
            "runtimeHint": "uvx",
            "transport": {
                "type": "stdio"
            },
            "environmentVariables": [
                {
                    "name": "AWESOME_DATA_DIR",
                    "description": "Directory containing a ready awesome.db database (built with ./awesome start).",
                    "isRequired": false
                }
            ]
        }
    ]
}
